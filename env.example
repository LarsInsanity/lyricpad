# Local development only. On Render, configure these in Environment.

# Required for hosted OpenAI suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Strongly recommended on a public Render URL.
# Create a long random value and enter the same value once in LyricPad Settings on each device.
APP_ACCESS_KEY=

# Optional local Ollama configuration (useful when running the server on your own PC).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# Local server port. Render provides PORT automatically, so do not set this on Render.
PORT=8787

# Optional local HTTPS for LAN testing only. Render provides HTTPS automatically.
HTTPS=0
HTTPS_PORT=8788
HTTPS_PFX=
HTTPS_PFX_PASS=lyricpad
