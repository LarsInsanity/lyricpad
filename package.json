{
  "name": "lyricpad-next",
  "version": "0.9.1",
  "private": true,
  "description": "Cross-platform songwriting notepad with phonetic rhyme intelligence and AI assistance",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node --check src/app.js && esbuild src/app.js --bundle --outfile=public/app.js --format=esm --target=es2020 --minify",
    "start": "node server.mjs",
    "dev": "npm run build && node server.mjs",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "codemirror": "^6.0.2",
    "esbuild": "^0.25.0",
    "firebase": "^12.16.0"
  }
}
